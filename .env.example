# ====================================================================
# AdmiMatrix Environment Configuration Schema
# ====================================================================

# Server-side provider keys. Do not prefix these with VITE_.
# The keys are used by the local API proxy and are never included in browser bundles.
GEMINI_API_KEY=

# Server-side Groq key. Do not prefix this with VITE_.
GROQ_API_KEY=

# APP_URL:
# The URL where this application is hosted. In AI Studio, this is automatically injected.
APP_URL="http://localhost:3000"

# ACTIVE MODEL ARCHITECTURE IN THIS BUILD:
# - Primary Fast & Multimodal: gemini-2.5-flash / gemini-3.8-flash (Standard)
# - Dynamic Flash Alias: gemini-flash-latest
# - Automatic Rate-Limit Fallback: gemini-3.1-flash-lite
# - Deep Institutional Reasoning: gemini-3.1-pro-preview
#
# MATHEMATICAL ENGINE SEPARATION NOTE:
# Numerical forecasting calculations (Logit-Linked Asymptotic Trend, Holt-Winters, 
# Monte Carlo prediction intervals) are strictly executed inside local TypeScript 
# modules (src/lib/ml). LLMs are strictly used for natural language explanation, 
# policy guidance, and optical document inspection.
