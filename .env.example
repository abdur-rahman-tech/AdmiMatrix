# Server-side Gemini key. Never add a VITE_ prefix; this key must not enter the
# browser bundle. In GitHub Actions, map the GEMINI_API_KEY repository secret
# to the deployed server process environment.
GEMINI_API_KEY=

# Owner-only admin sign-in credentials. Keep these server-side. Generate a
# admin PIN of at least 12 characters and a separate random session secret of
# at least 32 characters.
ADMIN_EMAIL=abdurrahman17180@gmail.com
ADMIN_PIN=
ADMIN_SESSION_SECRET=
ADMIN_NAME=Administrator

PORT=3000
