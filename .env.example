# Server-side Groq API key for ultra-fast LPU inference and reasoning models.
# Do not prefix with VITE_.
# The key is read by the local API proxy and never exposed in browser bundles.
GROQ_API_KEY=your_groq_api_key_here

# APP_URL:
# The local development URL
APP_URL="http://localhost:3000"

# ACTIVE GROQ MODEL ARCHITECTURE:
# - Primary Fast & Deep Reasoning: openai/gpt-oss-120b
# - Low-latency Efficient Reasoning: openai/gpt-oss-20b
#
# MATHEMATICAL ENGINE SEPARATION NOTE:
# Numerical forecasting calculations (Logit-Linked Asymptotic Trend, Holt-Winters, 
# Monte Carlo prediction intervals) are strictly executed inside local TypeScript 
